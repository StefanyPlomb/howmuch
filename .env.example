DJANGO_SECRET_KEY=troque-por-uma-chave-secreta
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=howmuch
DB_USER=howmuch
DB_PASSWORD=troque-por-uma-senha
DB_HOST=127.0.0.1
DB_PORT=5433

# Superusuário criado pelo comando `bootstrap`
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-por-uma-senha

# Porta exposta pelo container web no docker-compose (opcional, padrão 8011)
WEB_PORT=8011
